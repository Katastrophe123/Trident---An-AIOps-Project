# ---------------------------------------------------------------------------
# Copy to .env and adjust. NEVER commit a real .env.
#
# docker-compose.yml already sets everything the containers need, so this file
# is for running a service directly on the host (uvicorn, pytest, the tools).
# ---------------------------------------------------------------------------

ENVIRONMENT=local
LOG_LEVEL=INFO

# Which service this process is. The three services differ only by this and
# their command, so it is what appears in every log line and metric.
SERVICE_NAME=orders-service

# --- Database -------------------------------------------------------------
# Inside compose the host is `db`; from the host it is localhost:5436.
# The "bad config" chaos scenario works by overriding this with a wrong
# password, which is why it must come from the environment.
# aiops_app, not aiops: the services must be a non-superuser or the
# database-exhaustion scenario is invisible (see docker/initdb).
DATABASE_URL=postgresql+asyncpg://aiops_app:aiops@localhost:5436/aiops
DB_ECHO=false
# Small on purpose, so database exhaustion is reachable (see RUNBOOK.md).
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=3
# Short on purpose: pool_pre_ping keeps a live connection forever, so without
# recycling nothing ever asks for a new connection and the database-exhaustion
# scenario is invisible. See RUNBOOK.md scenario 5.
DB_POOL_RECYCLE_SECONDS=30

# --- Service-to-service ---------------------------------------------------
ORDERS_URL=http://localhost:8001
PAYMENTS_URL=http://localhost:8002
INVENTORY_URL=http://localhost:8003
DOWNSTREAM_TIMEOUT_SECONDS=10

# --- Observability --------------------------------------------------------
# Records kept in memory per service for GET /_logs.
LOG_BUFFER_SIZE=500

# --- Chaos ----------------------------------------------------------------
# Gates the /_chaos/* endpoints. Local demo only - a real service would never
# expose a fault-injection API.
CHAOS_ENABLED=true

# --- Traffic generator ----------------------------------------------------
TRAFFIC_RATE=2

# --- Phase 2 (the agent) --------------------------------------------------
# Not used yet. Any OpenAI-compatible endpoint works; Groq's free tier keeps
# costs near zero.
# LLM_PROVIDER=groq
# LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
